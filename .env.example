# UniFix environment variables.
# Copy to .env.local and fill in. Never commit real values (.env* is gitignored).
# The app runs without these using a deterministic in-memory store + seed data;
# set them to use the shared Supabase project and live AI.

# --- Supabase (client-safe; the anon key is a public client key) ---
# Project URL and anon key from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI (server-only; the ONLY true secret — never exposed to the browser) ---
# Anthropic API key used by the server-side classifier (Track A).
ANTHROPIC_API_KEY=
# Model id for classification; defaults to Claude Opus 5.5.
AI_MODEL=claude-opus-5-5
